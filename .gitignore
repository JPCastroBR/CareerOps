# Ambiente virtual
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Variáveis de ambiente
.env

# Banco de dados
data/*.db
data/*.sqlite
data/*.sqlite3

# Logs
logs/
*.log

# Estado local (memória de vagas processadas)
vagas_processadas.txt

# Credenciais sensíveis
credentials/
*.json

# VS Code
.vscode/

# Testes
.pytest_cache/
.coverage

# Sistema
.DS_Store
Thumbs.db

# Artefatos de transferência (n8n exports / credenciais locais)
temp/
tmp/

# Telemetria/dashboard (runtime)
data/telemetry/
config.json.bak

# Credenciais locais
secrets/

# Workflows do n8n (versionados)
!n8n/workflows/*.json

# estado transitório do n8n-sync
n8n/import.request
n8n/import.status

# snapshot de tenants InHire (sem segredos)
!data/inhire_companies.json
