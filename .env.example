# CareerOps - Environment Variables Template
# Copie para .env e preencha seus valores
# NUNCA commite o .env real (está no .gitignore)

# ===========================================
# IA - OpenAI ou OpenRouter (escolha um)
# ===========================================
# OpenAI direto
OPENAI_API_KEY=sk-your-openai-key-here

# OU OpenRouter (acesso a múltiplos modelos, mais barato)
# OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# Modelo preferido (se usar OpenRouter)
# OPENROUTER_MODEL=nemotron-3-ultra
# OPENROUTER_MODEL=gpt-4o-mini

# ===========================================
# Telegram Bot (para alertas + digest)
# ===========================================
# Crie bot via @BotFather no Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Chat ID onde recebe mensagens (use @userinfobot para descobrir)
TELEGRAM_CHAT_ID=123456789

# ===========================================
# n8n (gestão remota de workflows)
# ===========================================
# Gere em n8n: Settings → API → Create API Key
N8N_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Senha básica auth n8n (se habilitado)
N8N_PASSWORD=senha-forte-aqui

# ===========================================
# Google Service Account (Sheets/Docs)
# ===========================================
# NÃO coloque o JSON aqui - use o arquivo credentials/google-sa.json
# Este é só para referência do email da service account
GOOGLE_SA_EMAIL=n8n-bot@seu-projeto.iam.gserviceaccount.com

# IDs dos Google Docs do seu currículo (para workflow careerops-curriculo)
GOOGLE_DOC_PT_ID=1ABC...seu-doc-portugues...
GOOGLE_DOC_EN_ID=1XYZ...seu-doc-english...

# ID da Planilha Google Sheets de candidaturas
GOOGLE_SHEETS_ID=1ABC...sua-planilha...

# ===========================================
# JobSpy / LinkedIn / Indeed (opcional)
# ===========================================
# Cookies de sessão do LinkedIn (exportados do navegador)
# Use extensão "EditThisCookie" ou similar
# LINKEDIN_COOKIES="li_at=xxx; JSESSIONID=xxx; ..."

# ===========================================
# Configurações Opcionais
# ===========================================
# Timezone do servidor (para logs/cron)
TZ=America/Sao_Paulo

# Log level Python
LOG_LEVEL=INFO

# Max resultados por país (JobSpy)
MAX_RESULTS_PER_COUNTRY=200

# Rate limit entre POSTs n8n (segundos)
N8N_RATE_LIMIT_SECONDS=2.5