# CareerOps - Environment Variables Template
# Copie para .env e preencha seus valores.
# NUNCA commite o .env real (está no .gitignore).

# ===========================================
# Telegram — tokens injetados no n8n via docker-compose
# (IA e Google Service Account são configurados na UI do n8n, não aqui)
# ===========================================
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CURRICULO_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
